---
import Layout from "~/layouts/Layout.astro";
import Section from "~/components/Section.astro";
import Heading from "~/components/Heading.astro";
import FormContact from "~/components/forms/FormContact.astro";
---

<Layout title="Kontakt" pageTitle="Kontakt">
    <Section class="!py-0">
        <Heading class="!mb-10">
            <h2
                slot="heading-title"
                class="font-black text-brand-primary !mb-4"
            >
                Kontakt
            </h2>
            <p slot="heading-content">
                Bei Fragen oder Anfragen stehen wir gerne zur Verfügung.
            </p>
        </Heading>

        <FormContact />
    </Section>
</Layouttitle="Home">
