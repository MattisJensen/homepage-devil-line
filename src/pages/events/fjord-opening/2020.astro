---
import Layout from "~/layouts/Layout.astro";
import Section from "~/components/Section.astro";
import Hero from "~/components/Hero.astro";
import Heading from "~/components/Heading.astro";
import Badge from "~/components/Badge.astro";
import WideImage from "~/components/WideImage.astro";

// Images
import FjordOpeningImg from "~/assets/images/fjord-opening.jpeg";
---

<Layout
    title="Bork Havn Fjord Opening 2020"
    pageTitle="Bork Havn Fjord Opening 2020"
    description="Das Bork Havn Fjord Opening 2020 – abgesagt, aber nicht aufgegeben: Das Classic Race beim WW-Blow Out."
>
    <!-- Hero Image -->
    <WideImage
        image={FjordOpeningImg}
        alt="Windsurfer auf dem Ringkøbing Fjord beim Bork Havn Fjord Opening"
        class:list={"aspect-video lg:aspect-[16/3.5]"}
    />

    <!-- Breadcrumb -->
    <div class="container py-4">
        <nav class="text-sm text-gray-500 flex items-center gap-2">
            <a href="/events" class="hover:text-brand-primary transition"
                >Events</a
            >
            <span>/</span>
            <a
                href="/events/fjord-opening"
                class="hover:text-brand-primary transition"
                >Bork Havn Fjord Opening</a
            >
            <span>/</span>
            <span class="text-brand-black font-medium">2020</span>
        </nav>
    </div>

    <!-- Main -->
    <Section class:list={"bg-white"}>
        <Heading>
            <h1 slot="heading-title" class="font-black">
                Fjord Opening 2020
            </h1>
            <p slot="heading-content">
                Abgesagt – aber nicht aufgegeben: Das WW-Blow Out als
                Alternative.
            </p>
        </Heading>

        <Hero>
            <div
                slot="hero-content-left"
                class="prose max-w-none max-lg:order-1"
            >
                <h2 class="font-black mb-6">Über das Event</h2>
                <p>
                    Das Fjord Opening 2019 war großartig – und das Fjord
                    Opening 2020 musste leider aufgrund von Covid-19 abgesagt
                    werden. Aber das hat uns nicht davon abgehalten, das
                    Hauptrennen trotzdem möglich zu machen!
                </p>
                <p>
                    Deshalb lud Devil-Line Windsurfing in Zusammenarbeit mit
                    WestWind Bork zum <strong
                        >Bork Havn Fjord Opening 2020 beim WW-Blow Out</strong
                    > ein!
                </p>
                <h3 class="font-bold">Programm</h3>
                <ul>
                    <li>
                        <strong>1 Stunde Classic Race</strong> (je nach Wetter-
                        und Windbedingungen)
                    </li>
                    <li>30&nbsp;Minuten Pause</li>
                </ul>
                <p>
                    Jeder ist willkommen – unabhängig von Ausrüstung und
                    körperlichem Niveau. Ein Führerschein oder eine Segelnummer
                    ist nicht erforderlich. Sorgt für eine
                    Haftpflichtversicherung und persönliche
                    Sicherheitsausrüstung.
                </p>
            </div>

            <!-- Details Card -->
            <div
                slot="hero-content-right"
                class="bg-brand-secondary/20 rounded-lg p-8 flex flex-col gap-6 max-w-xl mx-auto w-full"
            >
                <h3 class="font-black text-xl text-brand-black !m-0">
                    Details 2020
                </h3>
                <div>
                    <p class="text-xs font-bold uppercase tracking-widest text-brand-primary mb-1">
                        Wann
                    </p>
                    <p class="font-semibold text-brand-black">
                        9.–10. Mai 2020
                    </p>
                </div>
                <div>
                    <p class="text-xs font-bold uppercase tracking-widest text-brand-primary mb-1">
                        Wo
                    </p>
                    <p class="font-semibold text-brand-black">
                        WestWind Bork, Dänemark
                    </p>
                    <p class="text-sm text-gray-600">
                        Bryggen 10, 6893 Hemmet
                    </p>
                </div>
                <div>
                    <p class="text-xs font-bold uppercase tracking-widest text-brand-primary mb-1">
                        Organisatoren
                    </p>
                    <p class="font-semibold text-brand-black">
                        Devil-Line Windsurfing &amp; WestWind Bork Havn
                    </p>
                </div>
                <div>
                    <p class="text-xs font-bold uppercase tracking-widest text-brand-primary mb-1">
                        Sicherheit
                    </p>
                    <ul class="text-sm text-gray-700 list-disc list-inside space-y-1">
                        <li>Zertifizierte Schwimmweste Pflicht</li>
                        <li>Foiler müssen einen Helm tragen</li>
                    </ul>
                </div>
                <div>
                    <p class="text-xs font-bold uppercase tracking-widest text-brand-primary mb-1">
                        Unterkunft
                    </p>
                    <p class="font-semibold text-brand-black">Danland</p>
                    <a
                        href="https://www.danland.de/ferienparks/bork-havn/"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-sm text-brand-primary underline"
                    >
                        danland.de/ferienparks/bork-havn
                    </a>
                </div>
            </div>
        </Hero>
    </Section>
</Layout>
