---
import Layout from "~/layouts/Layout.astro";
import Section from "~/components/Section.astro";
import Hero from "~/components/Hero.astro";
import { Picture } from "astro:assets";
import Badge from "~/components/Badge.astro";
import Grid4 from "~/components/Grid4.astro";
import Heading from "~/components/Heading.astro";
import WideImage from "~/components/WideImage.astro";
import WaveDivider from "~/components/WaveDivider.astro";
import { getStaticLangPaths, t, type Language } from "~/i18n";

// Images
import Tandem from "~/assets/images/tandem.jpeg";
import FjordOpening from "~/assets/images/fjord-opening.jpeg";
import TeamJan from "~/assets/images/team/jan.avif";
import TeamPeer from "~/assets/images/team/peer.avif";
import TeamMattis from "~/assets/images/team/mattis.avif";
import TeamKnipsi from "~/assets/images/team/knipsi.avif";

export function getStaticPaths() {
  return getStaticLangPaths();
}

const lang = Astro.params.lang as Language;
const txt = t(lang);
---

<Layout
  lang={lang}
  title={txt.home.pageTitle}
  pageTitle={txt.home.pageTitle}
  description={txt.home.metaDescription}
>
  <!-- Hero Banner -->
  <div class="relative">
    <WideImage
      image={FjordOpening}
      alt={txt.home.heroImageAlt}
      class:list={"aspect-[4/3] sm:aspect-video lg:aspect-[16/5]"}
    />
    <div
      class="absolute inset-0 bg-gradient-to-t from-brand-black/70 via-brand-black/20 to-transparent"
    >
    </div>
    <div
      class="absolute inset-x-0 bottom-0 container pb-8 sm:pb-12 lg:pb-16"
    >
      <Badge title={txt.home.badge} color="primary" />
      <h1 class="text-white font-black max-w-3xl">{txt.home.heading}</h1>
    </div>
  </div>

  <!-- Intro -->
  <Section class:list={"bg-white"}>
    <Hero>
      <div slot="hero-content-left" class="prose max-w-none max-lg:order-1">
        <p class="text-lg lg:text-xl leading-relaxed">{txt.home.intro}</p>
      </div>
      <div slot="hero-content-right">
        <Picture
          class:list={"mx-auto rounded-lg"}
          src={Tandem}
          height={600}
          formats={["avif", "webp"]}
          alt={txt.home.introImageAlt}
          loading={"eager"}
          fetchpriority={"high"}
        />
      </div>
    </Hero>
  </Section>

  <WaveDivider fill="#ffffff" class="bg-brand-surface" />

  <!-- Team -->
  <Section class:list={"bg-brand-surface"}>
    <Heading>
      <h2 slot="heading-title" class="font-black !mb-4">
        {txt.home.teamHeading}
      </h2>
      <p slot="heading-content" class="!mt-0">
        {txt.home.teamDescription}
      </p>
    </Heading>

    <Grid4>
      <div slot="grid-content-1">
        <div class="flex flex-col items-center text-center">
          <Picture
            class:list={"w-full h-auto rounded-lg mb-4"}
            src={TeamJan}
            formats={["avif", "webp"]}
            alt="Jan"
          />
          <h3 class="text-lg font-black text-brand-black">
            {txt.home.team.jan.role}
          </h3>
          <p class="text-sm text-brand-accent mt-1">
            <strong>Jan</strong> — {txt.home.team.jan.description}
          </p>
        </div>
      </div>

      <div slot="grid-content-2">
        <div class="flex flex-col items-center text-center">
          <Picture
            class:list={"w-full h-auto rounded-lg mb-4"}
            src={TeamPeer}
            formats={["avif", "webp"]}
            alt="Peer"
          />
          <h3 class="text-lg font-black text-brand-black">
            {txt.home.team.peer.role}
          </h3>
          <p class="text-sm text-brand-accent mt-1">
            <strong>Peer</strong> — {txt.home.team.peer.description}
          </p>
        </div>
      </div>

      <div slot="grid-content-3">
        <div class="flex flex-col items-center text-center">
          <Picture
            class:list={"w-full h-auto rounded-lg mb-4"}
            src={TeamMattis}
            formats={["avif", "webp"]}
            alt="Mattis"
          />
          <h3 class="text-lg font-black text-brand-black">
            {txt.home.team.mattis.role}
          </h3>
          <p class="text-sm text-brand-accent mt-1">
            <strong>Mattis</strong> — {txt.home.team.mattis.description}
          </p>
        </div>
      </div>

      <div slot="grid-content-4">
        <div class="flex flex-col items-center text-center">
          <Picture
            class:list={"w-full h-auto rounded-lg mb-4"}
            src={TeamKnipsi}
            formats={["avif", "webp"]}
            alt="Knipsi"
          />
          <h3 class="text-lg font-black text-brand-black">
            {txt.home.team.knipsi.role}
          </h3>
          <p class="text-sm text-brand-accent mt-1">
            <strong>Knipsi</strong> — {txt.home.team.knipsi.description}
          </p>
        </div>
      </div>
    </Grid4>
  </Section>
</Layout>
