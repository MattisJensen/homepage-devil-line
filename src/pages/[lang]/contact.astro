---
import Layout from "~/layouts/Layout.astro";
import Section from "~/components/Section.astro";
import Heading from "~/components/Heading.astro";
import FormContact from "~/components/forms/FormContact.astro";
import { getStaticLangPaths, t, type Language } from "~/i18n";

export function getStaticPaths() {
  return getStaticLangPaths();
}

const lang = Astro.params.lang as Language;
const txt = t(lang);
---

<Layout
  lang={lang}
  title={txt.contact.pageTitle}
  pageTitle={txt.contact.pageTitle}
  description={txt.contact.metaDescription}
>
  <Section class="!py-0">
    <Heading class="!mb-10">
      <h2 slot="heading-title" class="font-black text-brand-primary !mb-4">
        {txt.contact.heading}
      </h2>
      <p slot="heading-content">
        {txt.contact.description}
      </p>
    </Heading>

    <FormContact lang={lang} />
  </Section>
</Layout>
