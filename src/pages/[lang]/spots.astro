---
import Layout from "~/layouts/Layout.astro";
import Section from "~/components/Section.astro";
import Hero from "~/components/Hero.astro";
import Heading from "~/components/Heading.astro";
import { getStaticLangPaths, t, type Language } from "~/i18n";

export function getStaticPaths() {
  return getStaticLangPaths();
}

const lang = Astro.params.lang as Language;
const txt = t(lang);
---

<Layout
  lang={lang}
  title={txt.spots.pageTitle}
  pageTitle={txt.spots.pageTitle}
  description={txt.spots.metaDescription}
>
  <!-- Wittensee -->
  <Section>
    <Heading>
      <h1 slot="heading-title">{txt.spots.wittensee.title}</h1>
    </Heading>

    <Hero>
      <div slot="hero-content-left" class="prose max-w-none max-lg:order-1">
        <h2 class="font-black mb-10">{txt.spots.wittensee.conditionsHeading}</h2>
        <div set:html={txt.spots.wittensee.conditionsContent} />
      </div>

      <div
        slot="hero-content-right"
        class="bg-brand-secondary/20 rounded-lg hover:shadow-lg transition-all duration-400 transform hover:-translate-y-1 flex flex-col w-full max-w-xl mx-auto"
      >
        <div class="relative w-full aspect-video">
          <iframe
            src="https://www.youtube.com/embed/WycT51ZDrJ4"
            title="YouTube video player"
            class="absolute top-0 left-0 w-full h-full rounded-t-lg"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy"
            frameborder="0"></iframe>
        </div>
        <div class="p-4 flex-1 flex flex-col">
          <h3 class="!text-2xl text-brand-black line-clamp-2 mb-2">
            {txt.spots.wittensee.videoTitle}
          </h3>
          <p class="text-sm text-gray-500 mt-auto">
            {txt.spots.wittensee.videoDate}
          </p>
        </div>
      </div>
    </Hero>
  </Section>

  <!-- Wittensee Gefahren -->
  <Section>
    <Hero>
      <div
        slot="hero-content-left"
        class="relative w-full aspect-video max-lg:order-1"
      >
        <iframe
          src="https://www.google.com/maps/d/embed?mid=1RGOGuwgIPUu-Wikwb2kGar5VUjLaFyUE&ehbc=2E312F"
          title="Google Maps"
          class="absolute top-0 left-0 w-full h-full rounded-lg"
          allowfullscreen
          loading="lazy"
          frameborder="0"></iframe>
      </div>

      <div
        slot="hero-content-right"
        class="prose max-w-none max-lg:order-1"
      >
        <h2 class="font-black mb-10">{txt.spots.wittensee.dangersHeading}</h2>
        <div set:html={txt.spots.wittensee.dangersContent} />
      </div>
    </Hero>
  </Section>

  <!-- Bork Havn -->
  <Section class:list={"bg-brand-accent/20 relative"}>
    <Section />
    <Heading>
      <h1 slot="heading-title">{txt.spots.borkHavn.title}</h1>
    </Heading>

    <Hero>
      <div slot="hero-content-left" class="prose max-w-none max-lg:order-1">
        <h2 class="font-black mb-10">{txt.spots.borkHavn.conditionsHeading}</h2>
        <div set:html={txt.spots.borkHavn.conditionsContent} />
      </div>

      <div
        slot="hero-content-right"
        class="bg-brand-accent/20 rounded-lg hover:shadow-lg transition-all duration-400 transform hover:-translate-y-1 flex flex-col w-full max-w-xl mx-auto"
      >
        <div class="relative w-full aspect-video">
          <iframe
            src="https://www.youtube.com/embed/cBmsD6Kedhg"
            title="YouTube video player"
            class="absolute top-0 left-0 w-full h-full rounded-t-lg"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy"
            frameborder="0"></iframe>
        </div>
        <div class="p-4 flex-1 flex flex-col">
          <h3 class="!text-2xl text-brand-black line-clamp-2 mb-2">
            {txt.spots.borkHavn.videoTitle}
          </h3>
          <p class="text-sm text-gray-500 mt-auto">
            {txt.spots.borkHavn.videoDate}
          </p>
        </div>
      </div>
    </Hero>

    <!-- Bork Havn Gefahren -->
    <Hero>
      <div
        slot="hero-content-left"
        class="relative w-full aspect-video max-lg:order-1"
      >
        <iframe
          src="https://www.google.com/maps/d/embed?mid=1et2uG76j0_2SXqDdWf5Hb_H5qKWeQJwT&ehbc=2E312F"
          title="Google Maps"
          class="absolute top-0 left-0 w-full h-full rounded-lg"
          allowfullscreen
          loading="lazy"
          frameborder="0"></iframe>
      </div>

      <div
        slot="hero-content-right"
        class="prose max-w-none max-lg:order-1"
      >
        <h2 class="font-black mb-10">{txt.spots.borkHavn.dangersHeading}</h2>
        <div set:html={txt.spots.borkHavn.dangersContent} />
      </div>
    </Hero>

    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 1440 320"
      class="absolute h-40 w-full top-0 inset-x-0 rotate-180"
      preserveAspectRatio="none"
    >
      <path
        fill="#ffffff"
        fill-opacity="1"
        d="M0,288L48,272C96,256,192,224,288,197.3C384,171,480,149,576,165.3C672,181,768,235,864,250.7C960,267,1056,245,1152,250.7C1248,256,1344,288,1392,304L1440,320L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"
      ></path>
    </svg>
    <Section />
  </Section>
</Layout>
