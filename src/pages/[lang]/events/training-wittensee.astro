---
import Layout from "~/layouts/Layout.astro";
import Section from "~/components/Section.astro";
import Hero from "~/components/Hero.astro";
import Heading from "~/components/Heading.astro";
import Button from "~/components/Button.astro";
import WideImage from "~/components/WideImage.astro";
import { Picture } from "astro:assets";
import { getStaticLangPaths, t, localizedPath, type Language } from "~/i18n";

// Images
import TrainingHero from "~/assets/images/training/training02.jpg";
import Foil01 from "~/assets/images/training/foil01.jpg";
import Foil02 from "~/assets/images/training/foil02.jpg";
import Foil03 from "~/assets/images/training/foil03.jpg";
import Foil04 from "~/assets/images/training/foil04.jpg";
import Foil05 from "~/assets/images/training/foil05.jpg";
import Training05 from "~/assets/images/training/training05.jpg";

export function getStaticPaths() {
  return getStaticLangPaths();
}

const lang = Astro.params.lang as Language;
const txt = t(lang);
const p = txt.trainingWittensee;
---

<Layout
  lang={lang}
  title={p.pageTitle}
  pageTitle={p.pageTitle}
  description={p.metaDescription}
>
  <!-- Hero Image -->
  <WideImage
    image={Foil05}
    alt={p.heroImageAlt}
    class:list={"aspect-video lg:aspect-[16/3.5]"}
  />

  <!-- Breadcrumb -->
  <div class="container py-4">
    <nav class="text-sm text-gray-500 flex items-center gap-2">
      <a
        href={localizedPath(lang, "/events")}
        class="hover:text-brand-primary transition"
      >
        {txt.common.breadcrumbEvents}
      </a>
      <span>/</span>
      <span class="text-brand-black font-medium">{p.breadcrumb}</span>
    </nav>
  </div>

  <!-- Intro -->
  <Section class:list={"bg-white"}>
    <Heading>
      <h1 slot="heading-title" class="font-black">{p.heading}</h1>
      <p slot="heading-content">{p.intro}</p>
    </Heading>

    <Hero>
      <div slot="hero-content-left" class="prose max-w-none max-lg:order-1">
        <h2 class="font-black mb-6">{p.aboutHeading}</h2>
        <div set:html={p.aboutContent} />
      </div>

      <!-- Info Card -->
      <div
        slot="hero-content-right"
        class="bg-brand-secondary/20 rounded-lg p-8 flex flex-col gap-6 max-w-xl mx-auto w-full"
      >
        <div>
          <p class="text-xs font-bold uppercase tracking-widest text-brand-primary mb-1">
            {p.infoCard.venueLabel}
          </p>
          <p class="font-semibold text-brand-black">{p.infoCard.venue}</p>
          <p class="text-sm text-gray-600">{p.infoCard.venueRegion}</p>
        </div>
        <div>
          <p class="text-xs font-bold uppercase tracking-widest text-brand-primary mb-1">
            {p.infoCard.organizersLabel}
          </p>
          <p class="font-semibold text-brand-black">{p.infoCard.organizers}</p>
          <div>
            <p class="text-xs font-bold uppercase tracking-widest text-brand-primary mb-1">
              {p.infoCard.audienceLabel}
            </p>
            <ul class="text-sm text-gray-700 list-disc list-inside space-y-1">
              {p.infoCard.audience.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </div>
        <div>
          <p class="text-xs font-bold uppercase tracking-widest text-brand-primary mb-1">
            {p.infoCard.supportLabel}
          </p>
          <ul class="text-sm text-gray-700 space-y-1">
            {p.infoCard.support.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div>
          <p class="text-xs font-bold uppercase tracking-widest text-brand-primary mb-1">
            {p.infoCard.focusLabel}
          </p>
          <ul class="text-sm text-gray-700 list-disc list-inside space-y-1">
            {p.infoCard.focus.map((item) => <li>{item}</li>)}
          </ul>
        </div>

        <!-- CTA -->
        <div class="mt-2">
          <Button
            url="https://www.windsurfing-club-wittensee-rendsburg.de/Leistungssport/Training/"
            newtab={true}
            color="primary"
          >
            {p.infoCard.ctaButton}
          </Button>
        </div>
      </div>
    </Hero>
  </Section>

  <!-- Photo Gallery -->
  <Section class:list={"bg-white"}>
    <Heading>
      <h2 slot="heading-title" class="font-black">{p.galleryHeading}</h2>
    </Heading>
    <div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
      <Picture
        src={Foil01}
        formats={["avif", "webp"]}
        alt={p.galleryImages.foil01}
        class:list={"w-full h-64 object-cover rounded-lg"}
      />
      <Picture
        src={Foil02}
        formats={["avif", "webp"]}
        alt={p.galleryImages.foil02}
        class:list={"w-full h-64 object-cover rounded-lg"}
      />
      <Picture
        src={Foil03}
        formats={["avif", "webp"]}
        alt={p.galleryImages.foil03}
        class:list={"w-full h-64 object-cover rounded-lg"}
      />
      <Picture
        src={Foil04}
        formats={["avif", "webp"]}
        alt={p.galleryImages.foil04}
        class:list={"w-full h-64 object-cover rounded-lg"}
      />
      <Picture
        src={Training05}
        formats={["avif", "webp"]}
        alt={p.galleryImages.training05}
        class:list={"w-full h-64 object-cover rounded-lg"}
      />
      <Picture
        src={TrainingHero}
        formats={["avif", "webp"]}
        alt={p.galleryImages.trainingHero}
        class:list={"w-full h-64 object-cover rounded-lg"}
      />
    </div>
  </Section>

  <!-- CTA Section -->
  <Section class:list={"bg-brand-accent/20"}>
    <div class="max-w-2xl mx-auto text-center flex flex-col items-center gap-6">
      <h2 class="text-2xl font-black text-brand-black">{p.ctaHeading}</h2>
      <p class="text-gray-600">{p.ctaDescription}</p>
      <Button
        url="https://www.windsurfing-club-wittensee-rendsburg.de/Leistungssport/Training/"
        newtab={true}
        color="primary"
      >
        {p.ctaButton}
      </Button>
    </div>
  </Section>
</Layout>
