---
import Layout from "~/layouts/Layout.astro";
import Section from "~/components/Section.astro";
import Heading from "~/components/Heading.astro";
import { Picture } from "astro:assets";
import { getStaticLangPaths, t, localizedPath, type Language } from "~/i18n";

// Images
import FjordOpening from "~/assets/images/fjord-opening.jpeg";
import Foil03 from "~/assets/images/training/foil03.jpg";

export function getStaticPaths() {
  return getStaticLangPaths();
}

const lang = Astro.params.lang as Language;
const txt = t(lang);

const allEvents = [
  {
    title: txt.events.training.title,
    subtitle: txt.events.training.subtitle,
    description: txt.events.training.description,
    url: localizedPath(lang, "/events/training-wittensee"),
    badge: txt.events.training.badge,
    image: Foil03,
    imageAlt: txt.events.training.imageAlt,
    date: null,
  },
  {
    title: txt.events.fjordOpening2022.title,
    subtitle: txt.events.fjordOpening2022.subtitle,
    description: txt.events.fjordOpening2022.description,
    url: localizedPath(lang, "/events/fjord-opening/2022"),
    badge: txt.events.fjordOpening2022.badge,
    image: FjordOpening,
    imageAlt: txt.events.fjordOpening2022.imageAlt,
    date: new Date("2022-04-01"),
  },
  {
    title: txt.events.fjordOpening2020.title,
    subtitle: txt.events.fjordOpening2020.subtitle,
    description: txt.events.fjordOpening2020.description,
    url: localizedPath(lang, "/events/fjord-opening/2020"),
    badge: txt.events.fjordOpening2020.badge,
    image: FjordOpening,
    imageAlt: txt.events.fjordOpening2020.imageAlt,
    date: new Date("2020-05-09"),
  },
];

// Undated events first, then sorted newest → oldest
const events = allEvents.sort((a, b) => {
  if (!a.date && !b.date) return 0;
  if (!a.date) return -1;
  if (!b.date) return 1;
  return b.date.getTime() - a.date.getTime();
});
---

<Layout
  lang={lang}
  title={txt.events.pageTitle}
  pageTitle={txt.events.pageTitle}
  description={txt.events.metaDescription}
>
  <Section class:list={"bg-white"}>
    <Heading>
      <h1 slot="heading-title" class="font-black">{txt.events.heading}</h1>
      <p slot="heading-content">
        {txt.events.description}
      </p>
    </Heading>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      {
        events.map((event) => (
          <a
            href={event.url}
            class="group flex flex-col bg-white rounded-lg shadow-sm hover:shadow-lg transition-all duration-300 hover:-translate-y-1 overflow-hidden border border-brand-muted/60"
          >
            {event.image && (
              <div class="w-full aspect-video overflow-hidden">
                <Picture
                  src={event.image}
                  alt={event.imageAlt}
                  formats={["avif", "webp"]}
                  class:list={
                    "w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
                  }
                />
              </div>
            )}
            {!event.image && (
              <div class="w-full aspect-video bg-brand-secondary/20 flex items-center justify-center">
                <span class="text-brand-secondary text-6xl font-black select-none">
                  DL
                </span>
              </div>
            )}
            <div class="p-8 flex flex-col gap-3 flex-1">
              <span class="inline-flex w-fit items-center rounded-full px-3 py-1.5 text-xs font-semibold uppercase tracking-wider bg-brand-primary/10 text-brand-primary">
                {event.badge}
              </span>
              <h2 class="text-xl font-black text-brand-black group-hover:text-brand-primary transition-colors">
                {event.title}
              </h2>
              <p class="text-sm font-medium text-brand-accent">
                {event.subtitle}
              </p>
              <p class="text-gray-600 text-sm leading-relaxed flex-1">
                {event.description}
              </p>
              <span class="mt-4 inline-flex items-center gap-1 text-brand-primary font-semibold text-sm">
                {txt.common.learnMore}
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="size-4 group-hover:translate-x-1 transition-transform"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path
                    fill-rule="evenodd"
                    d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z"
                    clip-rule="evenodd"
                  />
                </svg>
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </Section>
</Layout>
