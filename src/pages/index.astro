---
import Layout from "~/layouts/Layout.astro";
import Section from "~/components/Section.astro";
import Hero from "~/components/Hero.astro";
import { Picture, Image } from "astro:assets";
import Badge from "~/components/Badge.astro";
import Grid4 from "~/components/Grid4.astro";
import Heading from "~/components/Heading.astro";
import WideImage from "~/components/WideImage.astro";

// Images
import Tandem from "~/assets/images/tandem.jpeg";
import FjordOpening from "~/assets/images/fjord-opening.jpg";
import TeamJan from "~/assets/images/team/jan.avif";
import TeamPeer from "~/assets/images/team/peer.avif";
import TeamMattis from "~/assets/images/team/mattis.avif";
import TeamKnipsi from "~/assets/images/team/knipsi.avif";
---

<Layout
    title="Home"
    pageTitle="Home"
    description="Welcome to Devil-Line Windsurfing!"
>
    <!-- Top -->
    <WideImage
        image={FjordOpening}
        alt="Two surfers riding together on a tandem windsurf board, enjoying the waves"
        class:list={"aspect-video lg:aspect-[16/7]"}
    />

    <!-- Intro -->
    <Section class:list={"bg-white"}>
        <Hero>
            <div
                slot="hero-content-left"
                class="prose max-w-none max-lg:order-1"
            >
                <h1 class="font-black mb-10">Devil-Line Windsurfing</h1>

                <p>
                    Dein Zuhause für Wind und Wasser. Egal, ob du ein erfahrener
                    Profi bist oder gerade erst anfängst - wir bringen
                    Windsurfer zusammen für unvergessliche Sessions, Events und
                    gute Zeiten auf und neben dem Wasser. Entdecke Trainings,
                    Wettbewerbe und eine Crew, die deine Leidenschaft für den
                    Sport teilt.
                </p>
                <div class="mb-16"></div>

                <Badge title="Work Less - Surf More" />
            </div>
            <div slot="hero-content-right">
                <Picture
                    class:list={"mx-auto"}
                    src={Tandem}
                    height={600}
                    formats={["avif", "webp"]}
                    alt="A description of my image."
                    loading={"eager"}
                    fetchpriority={"high"}
                />
            </div>
        </Hero>
    </Section>

    <!-- Team -->
    <Section class:list={"bg-brand-accent/20 relative"}>
        <div class="py-16">
            <!-- Intro -->
            <Heading>
                <h2 slot="heading-title" class="font-black !mb-4">
                    Lerne die leidenschaftliche Crew kennen
                </h2>
                <p slot="heading-content" class="!mt-0">
                    Devil-Line Windsurfing ist ein Team aus engagierten
                    Windsurfern, Kreativen und Eventorganisatoren mit einer
                    gemeinsamen Mission: den Sport weiterzuentwickeln und für
                    alle zugänglich zu machen. Von Trainingseinheiten und
                    Turnieren bis hin zu Meisterschaften und entspannten
                    BBQ-Abenden - wir organisieren Events, die die
                    Windsurf-Community zusammenbringen und die Freude an Wind
                    und Wasser feiern.
                </p>
            </Heading>

            <!-- People -->
            <Grid4>
                <div slot="grid-content-1">
                    <div class="flex flex-col items-center prose text-center">
                        <Picture
                            class:list={"not-prose w-full h-auto"}
                            src={TeamJan}
                            formats={["avif", "webp"]}
                            alt="A description of my image."
                        />
                        <h3 class="mt-0 font-black !text-2xl">Gründer</h3>
                        <p class="!text-base">
                            <strong>Jan </strong>
                            führt mit Vision und Energie, inspiriert das gesamte
                            Team und bringt Windsurfer auf und neben dem Wasser zusammen.
                        </p>
                    </div>
                </div>

                <div slot="grid-content-2">
                    <div class="flex flex-col items-center prose text-center">
                        <Picture
                            class:list={"not-prose w-full h-auto"}
                            src={TeamPeer}
                            formats={["avif", "webp"]}
                            alt="A description of my image."
                        />
                        <h3 class="mt-0 font-black !text-2xl">
                            Mitgründer und Leiter Social Media
                        </h3>
                        <p class="">
                            <strong>Peer </strong>
                            verbindet unsere Community, erzählt unsere Geschichte
                            und hält alle über die neuesten Events auf dem Laufenden.
                        </p>
                    </div>
                </div>

                <div slot="grid-content-3">
                    <div class="flex flex-col items-center prose text-center">
                        <Picture
                            class:list={"not-prose w-full h-auto"}
                            src={TeamMattis}
                            formats={["avif", "webp"]}
                            alt="A description of my image."
                        />
                        <h3 class="mt-0 font-black !text-2xl">
                            Medien Designer und Software Ingenieur
                        </h3>
                        <p class="">
                            <strong> Mattis </strong>
                            ist der kreative Kopf hinter unseren Visuals und der
                            Architekt unserer digitalen Welt.
                        </p>
                    </div>
                </div>

                <div slot="grid-content-4">
                    <div class="flex flex-col items-center prose text-center">
                        <Picture
                            class:list={"not-prose w-full h-auto"}
                            src={TeamKnipsi}
                            formats={["avif", "webp"]}
                            alt="A description of my image."
                        />
                        <h3 class="mt-0 font-black !text-2xl">
                            Foto- und Videospezialistin
                        </h3>
                        <p class="">
                            <strong>Knipsi </strong>
                            fängt unsere Begeisterung und den Spirit ein – mit ihrer
                            Kamera macht sie jeden Moment unvergesslich.
                        </p>
                    </div>
                </div>
            </Grid4>
        </div>

        <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 1440 320"
            class="absolute h-40 w-full top-0 inset-x-0 rotate-180"
            preserveAspectRatio="none"
            ><path
                fill="#ffffff"
                fill-opacity="1"
                d="M0,288L48,272C96,256,192,224,288,197.3C384,171,480,149,576,165.3C672,181,768,235,864,250.7C960,267,1056,245,1152,250.7C1248,256,1344,288,1392,304L1440,320L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"
            ></path>
        </svg>
        <!-- <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 1440 320"
            class="absolute h-40 w-full bottom-0 inset-x-0"
            preserveAspectRatio="none"
            ><path
                fill="#ffffff"
                fill-opacity="1"
                d="M0,288L48,272C96,256,192,224,288,197.3C384,171,480,149,576,165.3C672,181,768,235,864,250.7C960,267,1056,245,1152,250.7C1248,256,1344,288,1392,304L1440,320L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"
            ></path>
        </svg> -->
    </Section>

    <!-- <Section /> -->
</Layout>
