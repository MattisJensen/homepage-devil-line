---
import Layout from "~/layouts/Layout.astro";
import Section from "~/components/Section.astro";
import Hero from "~/components/Hero.astro";
import { Picture, Image } from "astro:assets";
import Badge from "~/components/Badge.astro";
import Grid4 from "~/components/Grid4.astro";
import Heading from "~/components/Heading.astro";
import WideImage from "~/components/WideImage.astro";

// Images
import HomeHeader from "~/assets/images/home-header.jpeg";
import TeamJan from "~/assets/images/team/jan.avif";
import TeamPeer from "~/assets/images/team/peer.avif";
import TeamMattis from "~/assets/images/team/mattis.avif";
import TeamKnipsi from "~/assets/images/team/knipsi.avif";
---

<Layout
    title="Home"
    pageTitle="Home"
    description="Welcome to Devil-Line Windsurfing!"
>
    <!-- Top -->
    <WideImage
        image={HomeHeader}
        alt="Two surfers riding together on a tandem windsurf board, enjoying the waves"
        class:list={"aspect-video lg:aspect-[16/7]"}
    />

    <!-- Intro -->
    <Section class:list={"bg-white"}>
        <Hero>
            <div
                slot="hero-content-left"
                class="prose max-w-none max-lg:order-1"
            >
                <h1 class="font-black mb-10">Devil-Line Windsurfing</h1>

                <p>
                    Your home for wind and water. Whether you’re a seasoned pro
                    or just starting out, we bring windsurfers together for
                    unforgettable sessions, events and good times on and off the
                    water. Discover training, competitions and a crew that
                    shares your passion for the sport.
                </p>
                <div class="mb-16"></div>

                <Badge title="Work Less - Surf More" />
            </div>
            <div slot="hero-content-right">
                <Picture
                    class:list={"mx-auto"}
                    src={HomeHeader}
                    height={600}
                    formats={["avif", "webp"]}
                    alt="A description of my image."
                    loading={"eager"}
                    fetchpriority={"high"}
                />
            </div>
        </Hero>
    </Section>

    <!-- Team -->
    <Section class:list={"bg-brand-accent/20 relative"}>
        <div class="py-16">
            <Heading>
                <h2 slot="heading-title" class="font-black !mb-4">
                    Meet the Passionate Crew
                </h2>
                <p slot="heading-content" class="!mt-0">
                    Devil-Line Windsurfing is a team of dedicated windsurfers,
                    creatives and event organizers united by one mission: to
                    grow the sport and make it more accessible to everyone. From
                    training sessions and tournaments to championships and
                    relaxed BBQ evenings, we create events that bring the
                    windsurfing community together and celebrate the joy of
                    riding the wind.
                </p>
            </Heading>

            <Grid4>
                <div slot="grid-content-1">
                    <div class="flex flex-col items-center prose text-center">
                        <Picture
                            class:list={"not-prose w-full h-auto"}
                            src={TeamJan}
                            formats={["avif", "webp"]}
                            alt="A description of my image."
                        />
                        <h5 class="mt-0 font-black">Jan</h5>
                        <p class="!text-base">
                            <strong>Founder</strong>
                            <br /><span class="mt-1 block"></span>
                            He leads with vision and energy, inspiring the whole
                            crew and bringing windsurfers together on and off the
                            water.
                        </p>
                    </div>
                </div>

                <div slot="grid-content-2">
                    <div class="flex flex-col items-center prose text-center">
                        <Picture
                            class:list={"not-prose w-full h-auto"}
                            src={TeamPeer}
                            formats={["avif", "webp"]}
                            alt="A description of my image."
                        />
                        <h5 class="mt-0 font-black">Peer</h5>
                        <p class="!text-base">
                            <strong
                                >Co-Founder and<br />Head of Social Media</strong
                            >
                            <br /><span class="mt-1 block"></span>
                            He connects our community, shares our story and keeps
                            everyone up to date with the latest events.
                        </p>
                    </div>
                </div>

                <div slot="grid-content-3">
                    <div class="flex flex-col items-center prose text-center">
                        <Picture
                            class:list={"not-prose w-full h-auto"}
                            src={TeamMattis}
                            formats={["avif", "webp"]}
                            alt="A description of my image."
                        />
                        <h5 class="mt-0 font-black">Mattis</h5>
                        <p class="!text-base">
                            <strong>
                                Media Designer and
                                <br />Software Engineer
                            </strong>
                            <br /><span class="mt-1 block"></span>
                            The creative mind behind our visuals and the architect
                            of our digital world.
                        </p>
                    </div>
                </div>

                <div slot="grid-content-4">
                    <div class="flex flex-col items-center prose text-center">
                        <Picture
                            class:list={"not-prose w-full h-auto"}
                            src={TeamKnipsi}
                            formats={["avif", "webp"]}
                            alt="A description of my image."
                        />
                        <h5 class="mt-0 font-black">Knipsi</h5>
                        <p class="!text-base">
                            <strong>Photo and Video Specialist</strong>
                            <br /><span class="mt-1 block"></span>
                            Knipsi captures our excitement and spirit, making every
                            moment unforgettable through her lens.
                        </p>
                    </div>
                </div>
            </Grid4>
        </div>

        <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 1440 320"
            class="absolute h-40 w-full top-0 inset-x-0 rotate-180"
            preserveAspectRatio="none"
            ><path
                fill="#ffffff"
                fill-opacity="1"
                d="M0,288L48,272C96,256,192,224,288,197.3C384,171,480,149,576,165.3C672,181,768,235,864,250.7C960,267,1056,245,1152,250.7C1248,256,1344,288,1392,304L1440,320L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"
            ></path>
        </svg>
        <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 1440 320"
            class="absolute h-40 w-full bottom-0 inset-x-0"
            preserveAspectRatio="none"
            ><path
                fill="#ffffff"
                fill-opacity="1"
                d="M0,288L48,272C96,256,192,224,288,197.3C384,171,480,149,576,165.3C672,181,768,235,864,250.7C960,267,1056,245,1152,250.7C1248,256,1344,288,1392,304L1440,320L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"
            ></path>
        </svg>
    </Section>

    <Section />
</Layout>
