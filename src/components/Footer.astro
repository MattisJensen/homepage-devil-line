---
const currentYear = new Date().getFullYear();
import { Picture } from "astro:assets";
import { siteName } from "~/data/config";
import WideImage from "./WideImage.astro";
import { t, defaultLanguage, type Language } from "~/i18n";

interface Props {
  lang?: Language;
}

const { lang = defaultLanguage } = Astro.props;
const txt = t(lang);

// Images
import LogoText from "~/assets/images/logo-text.png";
import Devil from "~/assets/images/footer.avif";
---

<footer class="bg-brand-black text-white">
    <WideImage
        image={Devil}
        alt="Footer Devil"
        class:list={""}
    />

    <div class="container py-12 lg:py-16">
        <div class="flex flex-col items-center gap-6">
            <a href={`/${lang}`} class="block">
                <Picture
                    class:list={"mx-auto"}
                    src={LogoText}
                    height={40}
                    formats={["avif", "webp"]}
                    alt="Devil-Line Windsurfing Logo"
                />
            </a>

            <p class="text-center text-sm text-white/60">
                &copy; {currentYear}
                {siteName}. {txt.footer.allRightsReserved}
            </p>

            <a
                class="text-sm text-white/40 hover:text-white transition-colors"
                href="/privacy-policy"
            >
                {txt.footer.privacyPolicy}
            </a>
        </div>
    </div>
</footer>
