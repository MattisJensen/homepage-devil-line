---
const { color = "primary", title = "" }: BadgeProps = Astro.props;

interface BadgeProps {
    color?: "secondary" | "primary";
    title?: string;
}

const colors = {
    secondary: "bg-brand-surface text-brand-accent",
    primary: "bg-brand-primary/10 text-brand-primary",
};
---

<span
    class={`inline-flex not-prose items-center mb-4 rounded-full px-4 py-1.5 text-xs font-semibold uppercase tracking-wider ${colors[color]}`}
    >{title}</span
>
