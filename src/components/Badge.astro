---
const { color = "primary", title = "" }: BadgeProps = Astro.props;

interface BadgeProps {
    color?: "secondary" | "primary";
    title?: string;
}

const colors = {
    secondary: "bg-brand-secondary/5 text-brand-secondary ring-1 ring-brand-secondary",
    primary: "bg-brand-primary/5 text-brand-primary ring-1 ring-brand-primary",
    white: "bg-white",
};
---

<span
    class={`inline-flex not-prose items-center mb-4 rounded-full px-3 py-1 text-base font-semibold ${colors[color]}`}
    >{title}</span
>
