---
const { color = "primary", title = "", mobileSize = "normal", class: customClass = "inline-flex" }: BadgeProps = Astro.props;

interface BadgeProps {
  color?: "secondary" | "primary";
  title?: string;
  mobileSize?: "small" | "normal";
  class?: string;
}

const colors = {
  secondary: "bg-brand-surface text-brand-accent",
  primary: "bg-brand-primary/20 text-brand-primary",
  background: "bg-brand-primary/20 text-brand-muted",
};

const mobileSizes = {
  small: "px-2 py-0.5 text-[0.55rem] mb-2",
  normal: "px-3 py-1 text-[0.65rem] mb-3",
};
---

<span
  class:list={[
    "w-fit self-start not-prose items-center rounded-full sm:px-4 sm:py-1.5 sm:text-xs sm:mb-4 font-semibold uppercase tracking-wider",
    colors[color],
    mobileSizes[mobileSize],
    customClass,
  ]}
  >{title}</span
>
