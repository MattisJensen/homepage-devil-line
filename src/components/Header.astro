---
import { Picture } from "astro:assets";
import { getMainMenu, getHomePath } from "~/data/menus";
import {
    languages,
    languageNames,
    defaultLanguage,
    switchLanguagePath,
    type Language,
} from "~/i18n";

interface Props {
    lang?: Language;
}

const { lang = defaultLanguage } = Astro.props;

const menuMain = getMainMenu(lang);
const home = getHomePath(lang);

const rmTrailingSlash = (path: string): string => {
    return path.endsWith("/") && path.length > 1
        ? path.slice(0, path.length - 1)
        : path;
};

const pathname = rmTrailingSlash(Astro.url.pathname);

// Images
import LogoText from "~/assets/images/logo-text.png";
---

<!--
    The frosted-glass background is a separate absolutely-positioned child
    rather than a style on <header> itself. This prevents backdrop-filter
    from creating a new CSS containing block on the sticky element, which
    would trap position:fixed children (a Safari/WebKit quirk).
-->
<header
    x-data="{ open: false }"
    @keydown.window.escape="open = false"
    class="sticky top-0 z-40 w-full"
>
    <!-- Frosted glass layer: isolated so it never traps fixed children -->
    <div
        class="absolute inset-0 bg-white/80 backdrop-blur-lg border-b border-brand-black/5 pointer-events-none"
        aria-hidden="true"
    ></div>

    <div class="container relative py-4">
        <nav class="flex items-center justify-between" aria-label="Global">
            <a href={home} class="shrink-0 mr-8">
                <Picture
                    class:list={"block"}
                    src={LogoText}
                    height={22}
                    formats={["avif", "webp"]}
                    alt="Devil-Line Windsurfing Logo"
                />
            </a>

            <!-- Mobile hamburger -->
            <button
                type="button"
                class="lg:hidden -m-2 p-2 rounded-lg hover:bg-brand-surface transition"
                @click="open = true"
            >
                <span class="sr-only">Open main menu</span>
                <svg
                    class="size-6 text-brand-black"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="currentColor"
                    aria-hidden="true"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"
                    ></path>
                </svg>
            </button>

            <!-- Desktop nav -->
            <div class="hidden lg:flex lg:items-center lg:gap-x-1">
                {
                    menuMain.map((item) => (
                        <a
                            href={item.url}
                            class={`px-4 py-2 rounded-lg text-sm font-medium transition-colors hover:bg-brand-surface hover:text-brand-primary ${item.highlighted ? "menu-item-highlighted" : ""} ${pathname === item.url ? "menu-item-active text-brand-primary" : "text-brand-accent"}`}
                        >
                            {item.name}
                        </a>
                    ))
                }
                <!-- Desktop language switcher -->
                <div
                    class="flex items-center gap-1 ml-3 pl-4 border-l border-brand-muted"
                >
                    {
                        languages.map((l) => (
                            <a
                                href={switchLanguagePath(Astro.url.pathname, l)}
                                class={`px-2 py-1 rounded text-xs font-semibold transition-colors ${
                                    l === lang
                                        ? "bg-brand-primary text-white"
                                        : "text-brand-accent hover:bg-brand-surface hover:text-brand-black"
                                }`}
                                aria-label={languageNames[l]}
                            >
                                {l.toUpperCase()}
                            </a>
                        ))
                    }
                </div>
            </div>
        </nav>
    </div>

    <!--
        Mobile overlay — lives inside <header> but uses position:fixed.
        This works correctly because <header> itself has no backdrop-filter,
        so it doesn't act as a fixed containing block.
    -->
    <div
        x-show="open"
        x-cloak
        class="lg:hidden fixed inset-0 z-[200]"
        aria-modal="true"
    >
        <!-- Click-away backdrop -->
        <div
            class="absolute inset-0 bg-brand-black/60"
            x-transition:enter="transition ease-out duration-200"
            x-transition:enter-start="opacity-0"
            x-transition:enter-end="opacity-100"
            x-transition:leave="transition ease-in duration-150"
            x-transition:leave-start="opacity-100"
            x-transition:leave-end="opacity-0"
            @click="open = false"
        ></div>

        <!-- Side panel — flex-col keeps lang switcher at bottom -->
        <div
            class="absolute inset-y-0 right-0 w-full max-w-sm bg-white shadow-2xl flex flex-col"
            x-transition:enter="transition ease-out duration-300"
            x-transition:enter-start="translate-x-full"
            x-transition:enter-end="translate-x-0"
            x-transition:leave="transition ease-in duration-200"
            x-transition:leave-start="translate-x-0"
            x-transition:leave-end="translate-x-full"
        >
            <!-- Top bar: logo + close -->
            <div
                class="shrink-0 flex items-center justify-between px-5 py-4 border-b border-brand-muted"
            >
                <a href={home} @click="open = false">
                    <Picture
                        class:list={"block"}
                        src={LogoText}
                        height={22}
                        formats={["avif", "webp"]}
                        alt="Devil-Line Windsurfing Logo"
                    />
                </a>
                <button
                    type="button"
                    class="-m-2 p-2 rounded-lg hover:bg-brand-surface transition"
                    @click="open = false"
                >
                    <span class="sr-only">Close menu</span>
                    <svg
                        class="size-6"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="1.5"
                        stroke="currentColor"
                        aria-hidden="true"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M6 18 18 6M6 6l12 12"></path>
                    </svg>
                </button>
            </div>

            <!-- Nav links — flex-1 fills available space, scrollable for long menus -->
            <nav class="flex-1 overflow-y-auto px-4 py-4 flex flex-col gap-1">
                {
                    menuMain.map((item) => (
                        <a
                            @click="open = false"
                            href={item.url}
                            class={`block px-4 py-3 rounded-lg text-base font-medium transition-colors ${item.highlighted ? "menu-item-highlighted !text-center" : ""} ${pathname === item.url ? "bg-brand-surface text-brand-primary" : "text-brand-black hover:bg-brand-surface"}`}
                        >
                            {item.name}
                        </a>
                    ))
                }
            </nav>

            <!-- Language switcher pinned to bottom via shrink-0 -->
            <div class="shrink-0 px-4 py-4 border-t border-brand-muted">
                <div class="flex gap-2">
                    {
                        languages.map((l) => (
                            <a
                                @click="open = false"
                                href={switchLanguagePath(Astro.url.pathname, l)}
                                class={`flex-1 text-center py-2.5 rounded-lg text-sm font-semibold transition-colors ${
                                    l === lang
                                        ? "bg-brand-primary text-white"
                                        : "bg-brand-surface text-brand-accent hover:bg-brand-muted"
                                }`}
                                aria-label={languageNames[l]}
                            >
                                {languageNames[l]}
                            </a>
                        ))
                    }
                </div>
            </div>
        </div>
    </div>
</header>
