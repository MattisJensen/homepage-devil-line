---
import { Picture } from "astro:assets";
import { getMainMenu, getHomePath } from "~/data/menus";
import {
  languages,
  languageNames,
  defaultLanguage,
  switchLanguagePath,
  type Language,
} from "~/i18n";

interface Props {
  lang?: Language;
}

const { lang = defaultLanguage } = Astro.props;

const menuMain = getMainMenu(lang);
const home = getHomePath(lang);

const rmTrailingSlash = (path: string): string => {
  return path.endsWith("/") && path.length > 1
    ? path.slice(0, path.length - 1)
    : path;
};

const pathname = rmTrailingSlash(Astro.url.pathname);

// Images
import LogoText from "~/assets/images/logo-text.png";
---

<header x-data="{ open: false }" @keydown.window.escape="open = false">
    <div class="container py-6">
        <nav class="flex items-center justify-between" aria-label="Global">
            <a href={home} class="-m-1.5 p-1.5 mr-6">
                <Picture
                    class:list={"mx-auto"}
                    src={LogoText}
                    height={25}
                    formats={["avif", "webp"]}
                    alt="Devil-Line Windsurfing Logo"
                />
            </a>
            <div class="flex lg:hidden">
                <button
                    type="button"
                    class="-m-2.5 inline-flex items-center justify-center rounded-md p-2.5"
                    @click="open = true"
                >
                    <span class="sr-only">Open main menu</span>
                    <svg
                        class="size-8 text-brand-primary"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="1.5"
                        stroke="currentColor"
                        aria-hidden="true"
                        data-slot="icon"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"
                        ></path>
                    </svg>
                </button>
            </div>
            <div class="hidden lg:flex lg:gap-x-12 lg:items-center">
                {
                    menuMain.map((item) => (
                        <a
                            href={item.url}
                            class={`transition text-base/6 font-semibold hover:text-brand-primary ${item.highlighted ? "menu-item-highlighted" : ""} ${pathname === item.url ? "menu-item-active" : ""}`}
                        >
                            {item.name}
                        </a>
                    ))
                }
                <!-- Language Switcher -->
                <div class="flex items-center gap-2 ml-4 border-l border-gray-300 pl-6">
                    {
                        languages.map((l, i) => (
                            <>
                                {i > 0 && <span class="text-gray-300">|</span>}
                                <a
                                    href={switchLanguagePath(Astro.url.pathname, l)}
                                    class={`text-sm font-semibold transition hover:text-brand-primary ${
                                        l === lang ? "text-brand-primary" : "text-gray-500"
                                    }`}
                                    aria-label={languageNames[l]}
                                >
                                    {l.toUpperCase()}
                                </a>
                            </>
                        ))
                    }
                </div>
            </div>
        </nav>
        <div
            class="lg:hidden"
            x-ref="dialog"
            x-show="open"
            x-cloak
            aria-modal="true"
        >
            <div
                class="fixed inset-0 z-50 w-full overflow-y-auto bg-white px-8 py-6"
                x-show="open"
                x-transition:enter="transition ease-out"
                x-transition:enter-start="opacity-0"
                x-transition:enter-end="opacity-100"
                x-transition:leave="transition ease-in"
                x-transition:leave-start="opacity-100"
                x-transition:leave-end="opacity-0"
                x-cloak
            >
                <div class="flex items-center justify-between">
                    <a href={home} class="-m-1.5 p-1.5 mr-6">
                        <Picture
                            class:list={"mx-auto"}
                            src={LogoText}
                            height={25}
                            formats={["avif", "webp"]}
                            alt="Devil-Line Windsurfing Logo"
                        />
                    </a>
                    <button
                        type="button"
                        class="-m-2.5 p-2.5 text-brand-secondary"
                        @click="open = false"
                    >
                        <span class="sr-only">Close menu</span>
                        <svg
                            class="size-8"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="2"
                            stroke="currentColor"
                            aria-hidden="true"
                            data-slot="icon"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M6 18 18 6M6 6l12 12"></path>
                        </svg>
                    </button>
                </div>
                <div class="mt-6 flow-root">
                    <div class="-my-6 divide-y divide-gray-500/10">
                        <div class="space-y-2 py-6 mt-16">
                            {
                                menuMain.map((item) => (
                                    <a
                                        @click="open = false"
                                        href={item.url}
                                        class={`block py-2 text-center font-semibold text-3xl ${item.highlighted ? "menu-item-highlighted w-max mx-auto !px-8 !py-2" : ""} ${pathname === item.url ? "menu-item-active" : ""}`}
                                    >
                                        {item.name}
                                    </a>
                                ))
                            }
                            <!-- Mobile Language Switcher -->
                            <div class="flex justify-center items-center gap-4 pt-8 mt-8 border-t border-gray-200">
                                {
                                    languages.map((l, i) => (
                                        <>
                                            {i > 0 && <span class="text-gray-300">|</span>}
                                            <a
                                                @click="open = false"
                                                href={switchLanguagePath(Astro.url.pathname, l)}
                                                class={`text-xl font-semibold transition ${
                                                    l === lang ? "text-brand-primary" : "text-gray-500"
                                                }`}
                                                aria-label={languageNames[l]}
                                            >
                                                {l.toUpperCase()}
                                            </a>
                                        </>
                                    ))
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</header>
