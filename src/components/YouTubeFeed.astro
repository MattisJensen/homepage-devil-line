---
import { Icon } from "astro-icon/components";
import "~/styles/global.css";
import { t, defaultLanguage, type Language } from "~/i18n";

interface Props {
  lang?: Language;
}

const { lang = defaultLanguage } = Astro.props;
const txt = t(lang).videos;

// Your YouTube Channel ID
const CHANNEL_ID = "UCDpPQ_XZ_bVrc9BQRR8kLJg"; // Replace channel ID
const MAX_VIDEOS = 45; // Number of videos to display

// Fetch YouTube RSS feed at build time
let videos = [];
let error = null;

try {
    const response = await fetch(
        `https://www.youtube.com/feeds/videos.xml?channel_id=${CHANNEL_ID}`
    );

    if (!response.ok) {
        throw new Error(`HTTP error! status: ${response.status}`);
    }

    const xmlText = await response.text();

    // Parse XML to extract video data
    const videoRegex =
        /<entry>.*?<yt:videoId>(.*?)<\/yt:videoId>.*?<title>(.*?)<\/title>.*?<published>(.*?)<\/published>.*?<\/entry>/gs;

    let match;
    while (
        (match = videoRegex.exec(xmlText)) !== null &&
        videos.length < MAX_VIDEOS
    ) {
        const [, videoId, title, published] = match;
        videos.push({
            id: videoId,
            title: title
                .replace(/&amp;/g, "&")
                .replace(/&lt;/g, "<")
                .replace(/&gt;/g, ">")
                .replace(/&quot;/g, '"')
                .replace(/&#39;/g, "'"),
            published: new Date(published),
            thumbnail: `https://img.youtube.com/vi/${videoId}/maxresdefault.jpg`,
            url: `https://www.youtube.com/watch?v=${videoId}`,
        });
    }
} catch (err) {
    console.error("Error fetching YouTube videos:", err);
    error = err instanceof Error ? err.message : String(err);
}

// Array for manually added YouTube videos
const manualVideos = [
    {
        id: "Odxan4VhoJQ",
        title: "Foiling Championships in Groß Wittensee - NDR Bericht",
        published: new Date("2023-09-30"),
        thumbnail: "https://img.youtube.com/vi/Odxan4VhoJQ/maxresdefault.jpg",
        url: "https://www.youtube.com/watch?v=Odxan4VhoJQ",
    },
];

// Array for blacklisted YouTube video IDs
const blacklistVideos = ["JRbOO_0Mosc", "rtZdHUEK-dQ"];

// Remove blacklisted videos
const filteredVideos = videos.filter(
    (video) => !blacklistVideos.includes(video.id)
);

// Combine manual videos and filtered fetched videos
videos = [...manualVideos, ...filteredVideos].slice(
    0,
    MAX_VIDEOS + manualVideos.length
);
---

<section class="py-8">
    <div class="w-full">
        {
            error ? (
                <div class="text-center py-8">
                    <p class="text-red-600 dark:text-red-400">
                        {txt.errorMessage}
                    </p>
                </div>
            ) : videos.length === 0 ? (
                <div class="text-center py-8">
                    <p class="text-gray-600">{txt.noVideos}</p>
                </div>
            ) : (
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    {videos.map((video) => (
                        <div class="bg-brand-secondary/20 rounded-lg hover:shadow-lg transition-all duration-400 transform hover:-translate-y-1 flex flex-col ">
                            <div class="relative w-full aspect-video">
                                <iframe
                                    src={`https://www.youtube.com/embed/${video.id}`}
                                    title={video.title}
                                    class="absolute top-0 left-0 w-full h-full rounded-t-lg"
                                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                    allowfullscreen
                                    loading="lazy"
                                />
                            </div>
                            <div class="p-4 flex-1 flex flex-col">
                                <h3 class="!text-2xl text-brand-black line-clamp-2 mb-2">
                                    {video.title}
                                </h3>
                                <p class="text-sm text-gray-500 mt-auto">
                                    {video.published.toLocaleDateString(
                                        txt.locale,
                                        {
                                            year: "numeric",
                                            month: "short",
                                            day: "numeric",
                                        }
                                    )}
                                </p>
                            </div>
                        </div>
                    ))}
                </div>
            )
        }

        <div class="text-center mt-8">
            <a
                href={`https://www.youtube.com/channel/${CHANNEL_ID}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center px-6 py-3 bg-red-600 hover:bg-red-700 text-brand-white rounded-lg transition-colors duration-300 font-bold"
            >
                <Icon name="mdi:youtube" class="w-5 h-5 mr-2" />
                {txt.subscribe}
            </a>
        </div>
    </div>
</section>

<style>
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>
